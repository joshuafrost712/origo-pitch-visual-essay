#!/usr/bin/env bash
# origo-site pre-push runner (W-00 D1). Runs every executable in pre-push.d/ in name order,
# each with the same stdin and arguments, and stops at the first failure.
#
# Installed by `npm run hooks:install` to $HOME/.config/origo-site/hooks, which core.hooksPath
# names absolutely, so it governs every checkout and worktree of the clone.
#
# CLIENT-SIDE ONLY: `git push --no-verify` skips every check here. That is the one unasserted
# assumption these guards rest on (planning defect class 13). The deploy workflow's branch
# trigger and its ancestry step are the second layer; the SEC-01 gate has none.
set -euo pipefail
hook_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Private settings live outside the public repo. Simple KEY=value lines; a variable already
# set in the environment wins, so a test can point a guard at a fixture.
env_file="$HOME/.config/origo-site/env"
if [ -f "$env_file" ]; then
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in ''|'#'*) continue ;; esac
    key="${line%%=*}"; val="${line#*=}"
    [[ "$key" =~ ^[A-Z_][A-Z0-9_]*$ ]] || continue
    val="${val%\"}"; val="${val#\"}"
    if [ -z "${!key+x}" ]; then export "$key=$val"; fi
  done < "$env_file"
fi

input="$(cat)"
for f in "$hook_dir"/pre-push.d/*; do
  [ -f "$f" ] && [ -x "$f" ] || continue
  if ! printf '%s\n' "$input" | "$f" "$@"; then
    echo "pre-push: $(basename "$f") refused the push" >&2
    exit 1
  fi
done
