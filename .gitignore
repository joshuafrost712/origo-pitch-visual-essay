# Dependencies / build
node_modules/
dist/
*.tsbuildinfo

# Dev feedback inbox: batches are read, acted on, then deleted — never committed.
feedback/incoming/*
!feedback/incoming/.gitkeep

# Screenshot tooling scratch (raw, unscrubbed captures live outside the repo)
tools/raw-captures/

# OS noise
.DS_Store

# Headshot candidates: full-size third-party photos, kept local; only the chosen crop ships from public/recommendations/
tools/headshot-candidates/

# Origo site runtime (mutant worktrees, drafts, local deploy state): local only, never committed
.origo-site-runtime/
.deploy-state/

# Screenshots for W specs
feedback/*-shots/
